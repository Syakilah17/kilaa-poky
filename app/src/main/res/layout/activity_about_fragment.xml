<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE4E1"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Judul Halaman Utama -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:text="Tentang Pocky"
            android:textColor="#C2185B"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Card Kartu Sejarah Pocky -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Foto Gambar Baru (poky.png) -->
                <ImageView
                    android:id="@+id/ivAboutPocky"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_marginBottom="16dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Foto Pocky"
                    android:scaleType="fitCenter"
                    android:src="@drawable/poky" />

                <!-- Subtitle Sejarah -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sejarah Pocky"
                    android:textColor="#C2185B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="60dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="14dp"
                    android:background="#E91E63" />

                <!-- Deskripsi Lengkap -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="6dp"
                    android:text="Pocky pertama kali diluncurkan pada tahun 1966 oleh Ezaki Glico di Jepang sebagai stik biskuit berlapis cokelat pertama di dunia. Nama 'Pocky' diambil dari bunyi renyah saat biskuit ini digigit ('pokkin-pokkin'). Kini Pocky menjadi camilan favorit global dengan beragam varian rasa lezat."
                    android:textAlignment="center"
                    android:textColor="#444444"
                    android:textSize="14sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card Informasi Tambahan / Fakta Menarik -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="✨ Fakta Menarik Pocky"
                    android:textColor="#C2185B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="• Tanggal 11 November diperingati sebagai 'Hari Pocky' di Jepang."
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Bagian bawah stik sengaja tidak dilapis cokelat agar tangan tetap bersih."
                    android:textColor="#555555"
                    android:textSize="13sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tombol Kunjungi Web -->
        <Button
            android:id="@+id/btnKunjungiWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#C2185B"
            android:padding="14dp"
            android:text="🌐 Kunjungi Website Resmi Pocky"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>