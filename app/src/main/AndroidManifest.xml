<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kilapocky"
        tools:targetApi="31">

        <!-- SplashActivity sebagai Peluncur Utama -->
        <activity
            android:name=".kl_pocky.SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Halaman Login -->
        <activity
            android:name=".kl_pocky.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Halaman Utama (Main) tempat Bottom Navigation & Fragment berada -->
        <activity
            android:name=".kl_pocky.MainActivity"
            android:exported="false" />

        <!-- Activity Tambahan -->
        <activity
            android:name=".kl_pocky.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".kl_pocky.DetailActivity"
            android:exported="false" />
        <activity
            android:name=".kl_pocky.activity_web"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".kl_pocky.activity_varian"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".kl_pocky.activity_about"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>